    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1/models/gemini-2.5-flash:generateContent?key=YOUR_GEMINI_API_KEY",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Compare the provided Resume against the given Job Description and evaluate the candidate for ATS compatibility.\\n\\nIMPORTANT:\\nReturn ONLY plain text.\\nDo NOT return JSON.\\nDo NOT return markdown code blocks.\\nDo NOT add greetings, notes, explanations, or any extra text.\\n\\nReturn strictly ONLY in the following format:\\n Dear Candidate,\\n Here is your ATS Match result:\\n\\nATS Score (0-100)\\n- XX/100\\n\\nMatch Status\\n- Excellent / Good / Average / Poor\\n\\nATS Feedback\\n- Point 1\\n- Point 2\\n- Point 3 (only if needed)\\n\\nMissing Skills\\n- Skill/Keyword 1\\n- Skill/Keyword 2\\n- Skill/Keyword 3\\n- Skill/Keyword 4\\n- Skill/Keyword 5\\n\\n(If there are no missing skills, write only:)\\n- No major missing skills.\\n\\nTailoring Tips\\n- Tip 1\\n- Tip 2\\n- Tip 3\\n\\nRules:\\n- ATS Score must be a number between 0 and 100 and display as XX/100.\\n- Match Status must be ONLY one of: Excellent, Good, Average, Poor.\\n- ATS Feedback must contain ONLY 2-3 concise bullet points (maximum 12 words per point).\\n- Missing Skills must contain ONLY the top 5 missing skills or keywords.\\n- Tailoring Tips must contain ONLY 3 short actionable bullet points (maximum 8 words per point).\\n- Every section must use bullet points.\\n- Keep the response concise, professional, and easy to read.\\n- Do NOT leave any section empty.\\n- Do NOT add any extra headings or text before or after the response.\\n\\nJob Description:\\n\"\n          + $('When Executed by Another Workflow').item.json.jobDescription +\n          \"\\n\\nResume:\\n\"\n          + $('Extract Resume Text').item.json.text\n        }\n      ]\n    }\n  ]\n}\n}}",
        "options": {
          "timeout": 60000
        }
      },
